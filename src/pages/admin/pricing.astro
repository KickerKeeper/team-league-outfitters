---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { TOWNS } from '../../lib/towns';
import { getCatalog, formatPriceCents } from '../../lib/catalog';

const townCatalogs = await Promise.all(
  TOWNS.map(async (t) => ({
    slug: t.slug,
    name: t.name,
    products: await getCatalog(t.slug),
  })),
);
---

<Admin title="Pricing" activeTab="pricing">
  <div class="pricing-header">
    <h1>Per-Town Product Catalog</h1>
    <p class="pricing-sub">
      Set the price and availability of each product per town. Disabled products are hidden from that town's order form. The jersey is always available.
    </p>
  </div>

  {townCatalogs.map((town) => (
    <div class="catalog-card">
      <div class="catalog-card-head">
        <strong>{town.name}</strong>
        <span class="town-slug">{town.slug}</span>
      </div>
      <div class="pricing-table">
        <div class="pricing-row pricing-head">
          <div>Product</div>
          <div>Price</div>
          <div>Available</div>
          <div></div>
        </div>
        {town.products.map((p) => (
          <form class="pricing-row" data-pricing-form data-slug={town.slug} data-product={p.id}>
            <div class="product-cell">
              <strong>{p.label}</strong>
              <span class="product-meta">
                {p.taxCategory === 'general' ? 'taxable' : 'clothing'}
                {p.sizing !== 'none' ? ' · sized' : ''}
                {p.personalized ? ' · name & number' : ''}
              </span>
            </div>
            <div class="price-cell">
              <span class="dollar">$</span>
              <input
                type="number"
                name="priceDollars"
                value={formatPriceCents(p.priceCents)}
                min="0"
                max="1000"
                step="0.01"
                inputmode="decimal"
                required
              />
            </div>
            <div class="enabled-cell">
              {p.personalized ? (
                <span class="required-badge">Required</span>
              ) : (
                <label class="toggle">
                  <input type="checkbox" name="enabled" checked={p.enabled} />
                  <span>Available</span>
                </label>
              )}
            </div>
            <div class="action-cell">
              <button type="submit" class="btn-save">Save</button>
              <span class="row-status" data-status></span>
            </div>
          </form>
        ))}
      </div>
    </div>
  ))}
</Admin>

<style is:global>
  .pricing-header { margin-bottom: var(--space-6); }
  .pricing-header h1 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .pricing-sub { color: var(--color-neutral-600); font-size: var(--text-sm); max-width: 640px; }

  .catalog-card {
    background: #fff;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: var(--space-6);
  }
  .catalog-card-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--color-primary);
    color: #fff;
  }
  .catalog-card-head strong { font-family: var(--font-heading); font-size: var(--text-lg); }
  .catalog-card-head .town-slug { font-family: var(--font-mono, monospace); font-size: var(--text-xs); opacity: 0.8; }

  .pricing-row {
    display: grid;
    grid-template-columns: 1.6fr 1.2fr 1.2fr auto;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-neutral-100);
  }
  .pricing-row:last-child { border-bottom: none; }

  .pricing-head {
    background: var(--color-neutral-50);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-neutral-600);
  }

  .product-cell { display: flex; flex-direction: column; gap: 2px; }
  .product-meta {
    font-size: var(--text-xs);
    color: var(--color-neutral-600);
    text-transform: capitalize;
  }

  .price-cell { display: flex; align-items: center; gap: var(--space-2); }
  .price-cell .dollar { font-family: var(--font-heading); font-weight: 600; color: var(--color-neutral-600); }
  .price-cell input {
    width: 100px;
    padding: 6px 10px;
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
  }

  .enabled-cell { font-size: var(--text-sm); }
  .toggle { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; color: var(--color-neutral-900); }
  .toggle input { width: 16px; height: 16px; cursor: pointer; }
  .required-badge {
    font-size: var(--text-xs);
    color: var(--color-primary);
    background: var(--color-neutral-50);
    border: 1px solid var(--color-neutral-200);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .action-cell { display: flex; align-items: center; gap: var(--space-3); justify-content: flex-end; }
  .btn-save {
    background: var(--color-primary);
    color: #fff;
    border: none;
    padding: 8px 18px;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .btn-save:hover { opacity: 0.9; }
  .btn-save:disabled { opacity: 0.5; cursor: not-allowed; }

  .row-status { font-size: var(--text-sm); min-width: 60px; }
  .row-status.ok { color: var(--color-success); }
  .row-status.err { color: var(--color-error); }

  @media (max-width: 767px) {
    .pricing-row { grid-template-columns: 1fr; gap: var(--space-2); }
    .pricing-head { display: none; }
    .pricing-row[data-pricing-form] { padding: var(--space-5) var(--space-4); gap: var(--space-3); }
    .action-cell { justify-content: flex-start; }
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-pricing-form]').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var slug = form.getAttribute('data-slug');
      var productId = form.getAttribute('data-product');
      var input = form.querySelector('input[name="priceDollars"]');
      var enabledEl = form.querySelector('input[name="enabled"]');
      var statusEl = form.querySelector('[data-status]');
      var btn = form.querySelector('button');

      statusEl.className = 'row-status';
      statusEl.textContent = '';
      btn.disabled = true;

      var payload = { slug: slug, productId: productId, priceDollars: parseFloat(input.value) };
      if (enabledEl) payload.enabled = enabledEl.checked;

      fetch('/api/pricing/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
        .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
        .then(function(res) {
          btn.disabled = false;
          if (res.ok) {
            statusEl.className = 'row-status ok';
            statusEl.textContent = 'Saved';
            setTimeout(function() { if (statusEl.textContent === 'Saved') statusEl.textContent = ''; }, 2500);
          } else {
            statusEl.className = 'row-status err';
            statusEl.textContent = (res.body && res.body.error) || 'Failed';
          }
        })
        .catch(function() {
          btn.disabled = false;
          statusEl.className = 'row-status err';
          statusEl.textContent = 'Network error';
        });
    });
  });
</script>
