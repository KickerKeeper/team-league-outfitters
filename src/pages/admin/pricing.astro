---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { getTowns } from '../../lib/towns';
import { getCatalog, PRODUCTS, formatPriceCents } from '../../lib/catalog';

const towns = await getTowns();
const townCatalogs = await Promise.all(
  towns.map(async (t) => ({
    slug: t.slug,
    name: t.name,
    custom: !!t.custom,
    products: await getCatalog(t.slug),
  })),
);
const productCols = PRODUCTS;
---

<Admin title="Pricing" activeTab="pricing">
  <div class="pricing-header">
    <h1>Catalog &amp; Pricing</h1>
    <p class="pricing-sub">
      Each row is a town, each column a product. Tick a product <strong>Available</strong> to put it on that town's order form, then set its price. Edits save automatically. The jersey is always available.
    </p>
  </div>

  <div class="matrix-wrap">
    <table class="matrix">
      <thead>
        <tr>
          <th class="corner">Town</th>
          {productCols.map((p) => (
            <th>
              <span class="col-label">{p.label}</span>
              <span class="col-meta">{p.taxCategory === 'general' ? 'taxable' : 'clothing'}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {townCatalogs.map((town) => (
          <tr>
            <th class="row-head">
              <span class="row-name">{town.name}</span>
              <span class="row-slug">{town.slug}</span>
            </th>
            {town.products.map((p) => (
              <td class="cell" data-slug={town.slug} data-product={p.id}>
                {p.personalized ? (
                  <span class="cell-req">Required</span>
                ) : (
                  <label class="cell-toggle">
                    <input type="checkbox" data-enabled checked={p.enabled} />
                    <span>Available</span>
                  </label>
                )}
                <div class="cell-price">
                  <span class="dollar">$</span>
                  <input
                    type="number"
                    data-price
                    value={formatPriceCents(p.priceCents)}
                    min="0"
                    max="1000"
                    step="0.01"
                    inputmode="decimal"
                    disabled={!p.personalized && !p.enabled}
                  />
                </div>
                <span class="cell-status" data-status></span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="add-town">
    <input type="text" id="new-town-name" placeholder="New town name (e.g., Beverly)" />
    <button id="add-town-btn" class="btn-save" type="button">+ Add town</button>
    <span id="add-town-status" class="add-town-status"></span>
  </div>
</Admin>

<style is:global>
  .pricing-header { margin-bottom: var(--space-6); }
  .pricing-header h1 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .pricing-sub { color: var(--color-neutral-600); font-size: var(--text-sm); max-width: 720px; }

  .matrix-wrap { overflow-x: auto; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-xl); background: #fff; }
  .matrix { border-collapse: collapse; width: 100%; min-width: 760px; }
  .matrix th, .matrix td { border-bottom: 1px solid var(--color-neutral-100); border-right: 1px solid var(--color-neutral-100); padding: var(--space-3) var(--space-4); text-align: left; vertical-align: top; }
  .matrix thead th { background: var(--color-neutral-50); font-family: var(--font-heading); font-size: var(--text-xs); color: var(--color-neutral-600); text-transform: uppercase; letter-spacing: 0.5px; position: sticky; top: 0; }
  .matrix .corner { background: var(--color-neutral-50); }
  .col-label { display: block; color: var(--color-neutral-900); font-size: var(--text-sm); }
  .col-meta { display: block; font-size: 10px; color: var(--color-neutral-600); font-weight: 400; text-transform: none; letter-spacing: 0; }

  .row-head { background: #fff; min-width: 130px; }
  .row-name { display: block; font-family: var(--font-heading); font-weight: 600; color: var(--color-neutral-900); }
  .row-slug { display: block; font-family: var(--font-mono, monospace); font-size: var(--text-xs); color: var(--color-neutral-600); }

  .cell { min-width: 120px; }
  .cell-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--color-neutral-900); cursor: pointer; }
  .cell-toggle input { width: 15px; height: 15px; cursor: pointer; }
  .cell-req { display: inline-block; font-size: 10px; color: var(--color-primary); background: var(--color-neutral-50); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-sm); padding: 1px 6px; text-transform: uppercase; letter-spacing: 0.5px; }
  .cell-price { display: flex; align-items: center; gap: 4px; margin-top: 6px; }
  .cell-price .dollar { color: var(--color-neutral-600); font-size: var(--text-sm); }
  .cell-price input { width: 72px; padding: 5px 8px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .cell-price input:disabled { background: var(--color-neutral-50); color: var(--color-neutral-400, #aaa); }
  .cell-status { display: inline-block; min-height: 14px; font-size: var(--text-xs); margin-top: 2px; }
  .cell-status.ok { color: var(--color-success); }
  .cell-status.err { color: var(--color-error); }

  .add-town { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
  .add-town input { padding: 8px 12px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); font-size: var(--text-base); min-width: 240px; }
  .btn-save { background: var(--color-primary); color: #fff; border: none; padding: 9px 18px; border-radius: var(--radius-md); font-family: var(--font-heading); font-weight: 600; font-size: var(--text-sm); cursor: pointer; }
  .btn-save:hover { opacity: 0.9; }
  .add-town-status { font-size: var(--text-sm); color: var(--color-neutral-600); }
  .add-town-status.err { color: var(--color-error); }
</style>

<script is:inline>
  function postUpdate(payload, statusEl) {
    statusEl.className = 'cell-status';
    statusEl.textContent = '…';
    fetch('/api/pricing/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function(r) { return r.json().then(function(b) { return { ok: r.ok, b: b }; }); })
      .then(function(res) {
        if (res.ok) {
          statusEl.className = 'cell-status ok';
          statusEl.textContent = '✓ Saved';
          setTimeout(function() { if (statusEl.textContent === '✓ Saved') statusEl.textContent = ''; }, 1500);
        } else {
          statusEl.className = 'cell-status err';
          statusEl.textContent = (res.b && res.b.error) || 'Failed';
        }
      })
      .catch(function() { statusEl.className = 'cell-status err'; statusEl.textContent = 'Error'; });
  }

  document.querySelectorAll('.cell').forEach(function(cell) {
    var slug = cell.getAttribute('data-slug');
    var productId = cell.getAttribute('data-product');
    var enabledEl = cell.querySelector('[data-enabled]');
    var priceEl = cell.querySelector('[data-price]');
    var statusEl = cell.querySelector('[data-status]');

    if (enabledEl) {
      enabledEl.addEventListener('change', function() {
        if (priceEl) priceEl.disabled = !enabledEl.checked;
        postUpdate({ slug: slug, productId: productId, enabled: enabledEl.checked }, statusEl);
      });
    }
    if (priceEl) {
      priceEl.addEventListener('change', function() {
        postUpdate({ slug: slug, productId: productId, priceDollars: parseFloat(priceEl.value) }, statusEl);
      });
    }
  });

  var addBtn = document.getElementById('add-town-btn');
  if (addBtn) {
    addBtn.addEventListener('click', function() {
      var input = document.getElementById('new-town-name');
      var status = document.getElementById('add-town-status');
      var name = (input.value || '').trim();
      status.className = 'add-town-status';
      if (!name) { status.className = 'add-town-status err'; status.textContent = 'Enter a town name'; return; }
      status.textContent = 'Adding…';
      addBtn.disabled = true;
      fetch('/api/towns/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name }),
      })
        .then(function(r) { return r.json().then(function(b) { return { ok: r.ok, b: b }; }); })
        .then(function(res) {
          if (res.ok) { status.textContent = 'Added — reloading…'; location.reload(); }
          else { addBtn.disabled = false; status.className = 'add-town-status err'; status.textContent = (res.b && res.b.error) || 'Failed'; }
        })
        .catch(function() { addBtn.disabled = false; status.className = 'add-town-status err'; status.textContent = 'Network error'; });
    });
  }
</script>
