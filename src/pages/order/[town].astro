---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import SizeOptions from '../../components/SizeOptions.astro';
import { getTown } from '../../lib/towns';
import { getWeekOfLabel } from '../../lib/week';
import { getCatalog, formatPriceCents, APPAREL_SIZES } from '../../lib/catalog';
import { getProgram, sizeHint } from '../../lib/programs';
import { isStripeConfigured } from '../../lib/stripe';

const { town: townSlug } = Astro.params;
const town = await getTown(townSlug!);

if (!town) {
  return Astro.redirect('/order');
}
if (town.comingSoon) {
  return Astro.redirect(`/order?soon=${town.slug}`);
}

const weekOf = getWeekOfLabel();
const catalog = (await getCatalog(town.slug)).filter((p) => p.enabled);
const jersey = catalog.find((p) => p.personalized) || catalog[0];
const addons = catalog.filter((p) => !jersey || p.id !== jersey.id);
const paymentEnabled = isStripeConfigured();
const wasCanceled = Astro.url.searchParams.get('canceled') === '1';

// Optional town program (e.g. Masco Hoops): new/existing player step, grade
// list, shop-coded sizes and manufacturer size charts.
const program = getProgram(town.slug);
const showGender = !program || program.collectGender;

// Inline measurement hints keyed by product id → size label.
const sizeHints: Record<string, Record<string, string>> = {};
if (program) {
  for (const p of catalog) {
    if (p.sizing !== 'apparel') continue;
    sizeHints[p.id] = {};
    program.sizeGroups.forEach((g) =>
      g.sizes.forEach((s) => {
        const h = sizeHint(program, p.id, s.label);
        if (h) sizeHints[p.id][s.label] = h;
      }),
    );
  }
}
---

<Base
  title={`Order — ${town.name} | Georgetown Jerseys`}
  description={`Order your child's ${town.name} uniform. Fill out the form and check out securely.`}
>
  <section class="page-header">
    <div class="container">
      <p class="back-link"><a href="/order">&larr; Choose a different town</a></p>
      <h1>{program ? program.heading : `${town.name} Uniform Order`}</h1>
      <p>{program ? program.eligibility : `Tell us about your order${paymentEnabled ? ' and check out securely.' : '.'}`}</p>
    </div>
  </section>

  <section class="section">
    <div class="container order-layout">
      <div class="form-area">
        {wasCanceled && (
          <div class="canceled-notice" role="alert">
            <strong>Payment canceled.</strong> No charge was made. Your details below are still here — adjust anything and try again, or call <a href="tel:+19783528240">(978) 352-8240</a> if you'd rather order over the phone.
          </div>
        )}

        {program && (
          <div class="program-info">
            <p>{program.description}</p>
            <p class="program-info-links">
              Not sure on sizing? <button type="button" class="link-btn" data-open-chart>View size charts</button>
            </p>
          </div>
        )}

        <form
          id="order-form"
          novalidate
          data-payment-enabled={paymentEnabled ? '1' : '0'}
          data-town-slug={town.slug}
          data-town-name={town.name}
        >
          <input type="hidden" name="form-name" value="parent-order" />
          <input type="hidden" name="town" value={town.name} />
          <input type="hidden" name="town_slug" value={town.slug} />
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <fieldset class="form-section">
            <legend>Your Info</legend>
            <p class="section-hint">We'll use this to reach you about pickup. Fields marked <span class="req" aria-hidden="true">*</span> are required.</p>
            <div class="form-grid">
              <div class="form-field">
                <label for="name">Parent / Guardian Name <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" />
              </div>
              <div class="form-field">
                <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </div>
              <div class="form-field">
                <label for="phone">Cell # (if we need to text you) <span class="req" aria-hidden="true">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" />
              </div>
            </div>
          </fieldset>

          <fieldset class="form-section">
            <legend>Players</legend>
            <p class="section-hint">
              One block per player. Add another if you're ordering for more than one.
            </p>

            <div id="players-list">
              <div class="player-block" data-player-block>
                <div class="player-block-header">
                  <span class="player-block-label" data-player-label>Player 1</span>
                  <button type="button" class="player-remove" data-player-remove hidden>Remove</button>
                </div>

                {program && (
                  <fieldset class="status-group" data-status-group>
                    <legend>{program.playerStatus.label} <span class="req" aria-hidden="true">*</span></legend>
                    <div class="status-options">
                      {program.playerStatus.options.map((o) => (
                        <label class="status-option">
                          <input
                            type="radio"
                            name="player_status_1"
                            value={o.value}
                            data-field="player_status"
                            data-collects-number={o.collectsNumber ? '1' : '0'}
                            data-number-note={o.note || ''}
                            required
                          />
                          <span>{o.label}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )}

                <div class="player-details" data-player-details hidden={!!program}>
                  <div class="form-grid">
                    <div class="form-field">
                      <label>Player Name <span class="req" aria-hidden="true">*</span></label>
                      <input type="text" data-field="player_name" required />
                    </div>
                    {showGender && (
                      <div class="form-field">
                        <label>Girl / Boy</label>
                        <select data-field="gender">
                          <option value="">—</option>
                          <option value="Girl">Girl</option>
                          <option value="Boy">Boy</option>
                        </select>
                      </div>
                    )}
                    {program ? (
                      <div class="form-field">
                        <label>Grade <span class="req" aria-hidden="true">*</span></label>
                        <select data-field="grade" required>
                          <option value="">Select grade</option>
                          {program.grades.map((g) => <option value={g}>{g}</option>)}
                        </select>
                      </div>
                    ) : (
                      <div class="form-field">
                        <label>School grade in the fall</label>
                        <input type="text" data-field="grade" placeholder="e.g., 4th" />
                      </div>
                    )}
                  </div>

                  {jersey && (
                    <div
                      class="product-line product-line-required"
                      data-product={jersey.id}
                      data-price-cents={jersey.priceCents}
                      data-sizing={jersey.sizing}
                      data-required="1"
                    >
                      <div class="product-line-head">
                        <strong>{jersey.label}</strong>
                        {paymentEnabled && <span class="product-price">${formatPriceCents(jersey.priceCents)}</span>}
                      </div>
                      <div class="form-grid">
                        <div class="form-field">
                          <label>
                            Size <span class="req" aria-hidden="true">*</span>
                            {program && <button type="button" class="link-btn size-chart-btn" data-open-chart>Size chart</button>}
                          </label>
                          <select data-field="size" required>
                            <SizeOptions program={program} />
                          </select>
                          {program && <p class="size-hint" data-size-hint hidden></p>}
                        </div>
                        <div class="form-field" data-number-field>
                          <div data-number-input>
                            <label>{program ? 'Current jersey number' : 'Number'} <span class="req" aria-hidden="true">*</span></label>
                            <input type="text" data-field="number" inputmode="numeric" pattern="[0-9]{1,3}" maxlength="3" autocomplete="off" required placeholder="e.g., 7" />
                          </div>
                          {program && <p class="field-note" data-number-note hidden></p>}
                        </div>
                      </div>
                    </div>
                  )}

                  {addons.map((p) => (
                    <div
                      class="product-line addon"
                      data-product={p.id}
                      data-price-cents={p.priceCents}
                      data-sizing={p.sizing}
                    >
                      <label class="addon-toggle">
                        <input type="checkbox" data-include />
                        <span>
                          Add {p.label}
                          {paymentEnabled && <> &mdash; ${formatPriceCents(p.priceCents)}{p.sizing === 'none' ? ' each' : ''}</>}
                        </span>
                      </label>
                      <div class="addon-fields" data-addon-fields hidden>
                        <div class="form-grid">
                          {p.sizing === 'apparel' && (
                            <div class="form-field">
                              <label>
                                Size
                                {program && <button type="button" class="link-btn size-chart-btn" data-open-chart>Size chart</button>}
                              </label>
                              <select data-field="size">
                                <SizeOptions program={program} />
                              </select>
                              {program && <p class="size-hint" data-size-hint hidden></p>}
                            </div>
                          )}
                          {p.sizing === 'shoe' && (
                            <div class="form-field">
                              <label>Shoe size</label>
                              <input type="text" data-field="size" placeholder="e.g., 5Y or 8" />
                            </div>
                          )}
                          {p.options && (
                            <div class="form-field">
                              <label>{p.options.label}</label>
                              <select data-field="option">
                                <option value="">Select</option>
                                {p.options.choices.map((c) => <option value={c}>{c}</option>)}
                              </select>
                            </div>
                          )}
                          {p.sizing === 'none' && (
                            <div class="form-field">
                              <label>Quantity</label>
                              <input type="number" data-field="quantity" min="1" max="20" value="1" />
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <button type="button" id="add-player" class="btn btn-secondary add-player-btn">+ Add another player</button>
          </fieldset>

          <fieldset class="form-section">
            <legend>Anything else?</legend>
            <div class="form-grid">
              <div class="form-field full-width">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" rows="3" placeholder="Anything we should know? (e.g., specific number not available, deadline, etc.)"></textarea>
              </div>
            </div>
          </fieldset>

          {paymentEnabled && (
            <div class="order-total" id="order-total" aria-live="polite">
              <div class="order-total-row total">
                <span>Subtotal</span>
                <span id="subtotal-display">$0.00</span>
              </div>
              <p class="tax-note">MA sales tax (where applicable) is calculated at checkout.</p>
            </div>
          )}

          <div class="final-sale-notice" role="note">
            <strong>All custom jersey sales are final.</strong>
            Once an order is placed, it goes straight into production with your kid's name and number &mdash; we can't take it back.
            <br />
            <strong>Not sure on sizing?</strong> Call the shop at <a href="tel:+19783528240">(978) 352-8240</a> <em>before</em> you order and we'll walk you through it.
          </div>

          <label class="acknowledge">
            <input type="checkbox" name="acknowledge_final_sale" required />
            <span>I understand all custom jersey sales are final.</span>
          </label>

          <p class="form-validation-summary" id="form-validation-summary" role="alert" hidden></p>

          <button type="submit" class="btn btn-primary submit-btn" id="submit-btn">
            {paymentEnabled ? 'Continue to Payment' : 'Submit Order'}
          </button>

          <p class="payment-note">
            {paymentEnabled
              ? "You'll be redirected to Stripe to enter card details and complete checkout. We never see your card."
              : "Payment will be collected after we confirm your order details. We'll be in touch within 1 business day."}
          </p>
        </form>

        <div class="form-success" id="form-success" hidden>
          <div class="success-icon">&#10003;</div>
          <h2>Got it!</h2>
          <p>Thanks! We'll be in touch within 1 business day to confirm your order and arrange payment.</p>
          <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>

        <div class="form-error" id="form-error" hidden>
          <h2>Something went wrong</h2>
          <p id="form-error-msg">Please call us at <a href="tel:+19783528240">(978) 352-8240</a> and we'll get you sorted.</p>
        </div>
      </div>

      <aside class="order-sidebar">
        <div class="sidebar-card card">
          {program && (
            <>
              <h3>Size charts</h3>
              <p>Garment measurements from the manufacturer.</p>
              <div class="sidebar-chart-links">
                {program.sizeGroups.map((g) => (
                  <button type="button" class="btn btn-secondary btn-sm" data-open-chart data-group={g.id}>{g.label}</button>
                ))}
              </div>
              <hr />
            </>
          )}
          <h3>Prefer to call?</h3>
          <p>We're happy to help over the phone.</p>
          <p class="sidebar-phone"><a href="tel:+19783528240">(978) 352-8240</a></p>
          <p class="sidebar-phone"><a href="tel:+19783604359">(978) 360-4359</a></p>
          <hr />
          <h4>Hours &mdash; Week of {weekOf}</h4>
          <p>Wed &ndash; Fri: 11am &ndash; 5pm<br />Sat: 8am &ndash; Noon</p>
          <p class="sidebar-hours-note">Hours vary weekly &mdash; call ahead to confirm.</p>
          <hr />
          <h4>Visit Us</h4>
          <p>103 E Main St #2<br />Georgetown, MA 01833</p>
        </div>
      </aside>
    </div>
  </section>

  {program && (
    <dialog class="size-dialog" id="size-dialog" aria-label="Size charts">
      <div class="size-dialog-head">
        <h3>Size charts</h3>
        <button type="button" class="size-dialog-close" data-chart-close aria-label="Close">&times;</button>
      </div>
      <div class="chart-tabs" role="tablist">
        {program.sizeGroups.map((g, i) => (
          <button type="button" role="tab" class="chart-tab" data-chart-tab={g.id} aria-selected={i === 0 ? 'true' : 'false'}>{g.label}</button>
        ))}
      </div>
      {program.sizeGroups.map((g, i) => (
        <div class="chart-panel" data-chart-panel={g.id} hidden={i !== 0}>
          {program.charts.filter((c) => c.groupId === g.id).map((c) => {
            const cols = g.sizes
              .map((s) => ({ s, idx: c.columns.indexOf(s.chartColumn) }))
              .filter((x) => x.idx >= 0);
            return (
              <div class="chart">
                <div class="chart-title"><strong>{c.title}</strong> <span class="chart-model">{c.model}</span></div>
                <div class="chart-scroll">
                  <table class="chart-table">
                    <thead>
                      <tr>
                        <th>Inches</th>
                        {cols.map((x) => <th>{x.s.chartColumn}<small>{x.s.code}</small></th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {c.rows.map((r) => (
                        <tr>
                          <td>{r.label}</td>
                          {cols.map((x) => <td>{r.values[x.idx]}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <a href={c.pdf} target="_blank" rel="noopener" class="chart-pdf">Manufacturer spec sheet (PDF) &rarr;</a>
              </div>
            );
          })}
          <p class="chart-note">These are garment measurements from A4. Still unsure? Call the shop at <a href="tel:+19783528240">(978) 352-8240</a> before you order.</p>
        </div>
      ))}
    </dialog>
  )}

  <script type="application/json" id="size-hints" set:html={JSON.stringify(sizeHints)} />
</Base>

<style>
  .page-header { background: var(--color-primary); color: #fff; padding: var(--space-10) var(--space-6) var(--space-12); text-align: center; }
  .page-header h1 { color: #fff; margin-bottom: var(--space-3); }
  .page-header p { opacity: 0.9; max-width: 520px; margin: 0 auto; }

  .back-link { margin-bottom: var(--space-4); font-size: var(--text-sm); opacity: 0.85; }
  .back-link a { color: #fff; text-decoration: underline; }

  .canceled-notice {
    background: #fff8e6; border-left: 4px solid var(--color-accent); border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5); margin-bottom: var(--space-6);
    font-size: var(--text-sm); line-height: 1.5; color: var(--color-neutral-900);
  }
  .canceled-notice a { color: var(--color-primary); font-weight: 600; }

  .program-info {
    background: var(--color-neutral-50, #fafafa); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5); margin-bottom: var(--space-6); font-size: var(--text-sm); line-height: 1.55; color: var(--color-neutral-900);
  }
  .program-info p { margin: 0; }
  .program-info-links { margin-top: var(--space-2) !important; color: var(--color-neutral-600); }

  .link-btn { background: none; border: none; padding: 0; color: var(--color-primary); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  .link-btn:hover { color: var(--color-primary-dark, var(--color-primary)); }
  .size-chart-btn { display: inline-block; margin-left: var(--space-2); padding: 3px 10px; border: 1px solid var(--color-primary); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 600; text-decoration: none; line-height: 1.4; vertical-align: middle; }
  .size-chart-btn:hover { background: var(--color-primary); color: #fff; }

  .order-layout { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  @media (min-width: 768px) { .order-layout { grid-template-columns: 1fr 300px; align-items: start; } }

  .form-section { border: 1px solid var(--color-neutral-200); border-radius: var(--radius-xl); padding: var(--space-6); margin-bottom: var(--space-6); }
  .form-section legend { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-xl); color: var(--color-primary); padding: 0 var(--space-2); }
  .section-hint { color: var(--color-neutral-600); font-size: var(--text-sm); margin-top: var(--space-2); }

  .form-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-4); margin-top: var(--space-4); }
  @media (min-width: 768px) { .form-grid { grid-template-columns: repeat(2, 1fr); } .form-field.full-width { grid-column: 1 / -1; } }
  .form-field label { margin-bottom: var(--space-1); }
  .req { color: var(--color-error); }
  .hidden { display: none !important; }
  .field-error { display: block; color: var(--color-error); font-size: var(--text-sm); margin-top: var(--space-1); line-height: 1.4; }
  .status-group.has-error .status-option { border-color: var(--color-error); }
  .acknowledge.has-error { border-color: var(--color-error); box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1); }
  .form-validation-summary { background: #fdecee; border-left: 4px solid var(--color-error); color: var(--color-neutral-900); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); font-size: var(--text-sm); margin-bottom: var(--space-3); }
  .field-note { font-size: var(--text-sm); color: var(--color-neutral-600); line-height: 1.45; margin: 0; padding-top: var(--space-6); }
  .size-hint { font-size: var(--text-xs); color: var(--color-neutral-600); margin: var(--space-1) 0 0; line-height: 1.4; }

  .player-block { border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: var(--space-5); margin-top: var(--space-4); background: var(--color-neutral-50, #fafafa); }
  .player-block-header { display: flex; justify-content: space-between; align-items: center; }
  .player-block-label { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--color-primary); }
  .player-remove { background: none; border: none; color: var(--color-error); font-size: var(--text-sm); cursor: pointer; padding: var(--space-1) var(--space-2); }
  .player-remove:hover { text-decoration: underline; }
  .add-player-btn { margin-top: var(--space-4); }

  .status-group { border: none; padding: 0; margin: var(--space-4) 0 0; }
  .status-group legend { font-weight: 600; font-size: var(--text-base); color: var(--color-neutral-900); padding: 0; margin-bottom: var(--space-2); }
  .status-options { display: grid; grid-template-columns: 1fr; gap: var(--space-2); }
  @media (min-width: 480px) { .status-options { grid-template-columns: repeat(2, 1fr); } }
  .status-option { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); background: #fff; cursor: pointer; font-weight: 500; }
  .status-option input { width: auto; margin: 0; }
  .status-option:has(input:checked) { border-color: var(--color-primary); box-shadow: 0 0 0 2px var(--color-primary-light, rgba(30, 68, 120, 0.15)); }

  .product-line { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px dashed var(--color-neutral-200); }
  .product-line-head { display: flex; justify-content: space-between; align-items: baseline; }
  .product-line-head strong { font-family: var(--font-heading); color: var(--color-neutral-900); }
  .product-price { font-family: var(--font-heading); font-weight: 600; color: var(--color-primary); }
  .addon-toggle { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-size: var(--text-sm); }
  .addon-toggle input { width: auto; }
  .addon-fields { margin-top: 0; }

  .order-total { border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4); background: #fff; }
  .order-total-row { display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-neutral-600); padding: var(--space-1) 0; }
  .order-total-row.total { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--color-neutral-900); }
  .tax-note { font-size: var(--text-xs); color: var(--color-neutral-600); margin-top: var(--space-2); font-style: italic; }

  .final-sale-notice { background: var(--color-accent-light); border-left: 4px solid var(--color-accent); padding: var(--space-4) var(--space-5); border-radius: var(--radius-md); margin-bottom: var(--space-4); font-size: var(--text-sm); line-height: 1.55; color: var(--color-neutral-900); }
  .final-sale-notice a { color: var(--color-primary); font-weight: 600; }

  .acknowledge { display: flex; align-items: flex-start; gap: var(--space-2); margin-bottom: var(--space-4); padding: var(--space-3); border: 1px solid var(--color-neutral-200); border-radius: var(--radius-md); cursor: pointer; font-size: var(--text-sm); }
  .acknowledge { flex-wrap: wrap; }
  .acknowledge input { margin-top: 3px; width: auto; flex-shrink: 0; }
  .acknowledge .field-error { flex-basis: 100%; margin-top: var(--space-2); }

  .submit-btn { width: 100%; padding: 16px; font-size: var(--text-lg); margin-top: var(--space-2); }
  .submit-btn:disabled { opacity: 0.6; cursor: progress; }
  .payment-note { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-neutral-600); text-align: center; }

  .form-success, .form-error { text-align: center; padding: var(--space-12) var(--space-6); }
  .success-icon { width: 64px; height: 64px; background: var(--color-success); color: #fff; font-size: 2rem; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--space-4); }
  .form-success h2, .form-error h2 { margin-bottom: var(--space-3); }
  .form-success p, .form-error p { color: var(--color-neutral-600); margin-bottom: var(--space-6); }

  .sidebar-card { position: sticky; top: calc(var(--header-height) + var(--space-6)); }
  .sidebar-card h3 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .sidebar-card h4 { font-size: var(--text-base); margin-bottom: var(--space-1); }
  .sidebar-card p { font-size: var(--text-sm); color: var(--color-neutral-600); }
  .sidebar-phone a { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--color-primary); }
  .sidebar-card hr { border: none; border-top: 1px solid var(--color-neutral-200); margin: var(--space-4) 0; }
  .sidebar-hours-note { font-size: var(--text-xs); color: var(--color-neutral-900); background: var(--color-accent-light); border-left: 3px solid var(--color-accent); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); margin-top: var(--space-2); line-height: 1.4; }
  .sidebar-chart-links { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .btn-sm { padding: 8px 14px; font-size: var(--text-sm); }

  /* Size chart dialog */
  .size-dialog { position: fixed; inset: 0; margin: auto; width: min(680px, calc(100vw - 32px)); max-height: calc(100vh - 48px); overflow-y: auto; border: none; border-radius: var(--radius-xl); padding: var(--space-5) var(--space-6) var(--space-6); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); color: var(--color-neutral-900); }
  .size-dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
  .size-dialog-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); }
  .size-dialog-head h3 { margin: 0; font-size: var(--text-xl); }
  .size-dialog-close { background: none; border: none; font-size: 1.75rem; line-height: 1; cursor: pointer; color: var(--color-neutral-600); padding: 0 var(--space-1); }
  .size-dialog-close:hover { color: var(--color-neutral-900); }
  .chart-tabs { display: flex; gap: var(--space-2); border-bottom: 1px solid var(--color-neutral-200); margin-bottom: var(--space-4); }
  .chart-tab { background: none; border: none; border-bottom: 3px solid transparent; padding: var(--space-2) var(--space-3); font: inherit; font-weight: 600; color: var(--color-neutral-600); cursor: pointer; margin-bottom: -1px; }
  .chart-tab[aria-selected="true"] { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .chart { margin-bottom: var(--space-5); }
  .chart-title { margin-bottom: var(--space-2); }
  .chart-model { color: var(--color-neutral-600); font-size: var(--text-sm); margin-left: var(--space-1); }
  .chart-scroll { overflow-x: auto; }
  .chart-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .chart-table th, .chart-table td { border: 1px solid var(--color-neutral-200); padding: var(--space-2) var(--space-3); text-align: center; white-space: nowrap; }
  .chart-table th { background: var(--color-neutral-50, #fafafa); font-weight: 600; }
  .chart-table th small { display: block; font-weight: 400; color: var(--color-neutral-600); font-size: var(--text-xs); }
  .chart-table td:first-child, .chart-table th:first-child { text-align: left; }
  .chart-pdf { display: inline-block; margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-primary); font-weight: 600; }
  .chart-note { font-size: var(--text-sm); color: var(--color-neutral-600); margin: 0; }
  .chart-note a { color: var(--color-primary); font-weight: 600; }
</style>

<script>
  const playersList = document.getElementById('players-list')!;
  const addBtn = document.getElementById('add-player') as HTMLButtonElement;
  const form = document.getElementById('order-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successDiv = document.getElementById('form-success') as HTMLElement;
  const errorDiv = document.getElementById('form-error') as HTMLElement;
  const errorMsg = document.getElementById('form-error-msg') as HTMLElement;
  const sizeDialog = document.getElementById('size-dialog') as HTMLDialogElement | null;

  const paymentEnabled = form.dataset.paymentEnabled === '1';
  const townSlug = form.dataset.townSlug || '';
  const townName = form.dataset.townName || '';
  const subtotalDisplay = document.getElementById('subtotal-display');

  let sizeHints: Record<string, Record<string, string>> = {};
  try { sizeHints = JSON.parse(document.getElementById('size-hints')?.textContent || '{}'); } catch { sizeHints = {}; }

  function fieldVal(scope: Element, name: string): string {
    const el = scope.querySelector('[data-field="' + name + '"]') as HTMLInputElement | HTMLSelectElement | null;
    return el ? String(el.value || '').trim() : '';
  }

  function checkedStatus(block: Element): HTMLInputElement | null {
    return block.querySelector('[data-field="player_status"]:checked') as HTMLInputElement | null;
  }

  // Program towns: nothing else shows until new/existing is picked, and the
  // jersey number is only asked for when that choice collects one.
  function applyStatus(block: Element) {
    if (!block.querySelector('[data-status-group]')) return;
    const details = block.querySelector('[data-player-details]') as HTMLElement | null;
    if (!details) return;
    const status = checkedStatus(block);
    details.hidden = !status;
    // Hidden controls are disabled so they can't be required-but-unfocusable.
    details.querySelectorAll('input, select').forEach((el) => { (el as HTMLInputElement).disabled = !status; });
    const collects = status ? status.getAttribute('data-collects-number') === '1' : true;
    block.querySelectorAll('[data-number-field]').forEach((f) => {
      const wrap = f.querySelector('[data-number-input]') as HTMLElement | null;
      const input = f.querySelector('[data-field="number"]') as HTMLInputElement | null;
      const note = f.querySelector('[data-number-note]') as HTMLElement | null;
      if (wrap) wrap.hidden = !collects;
      if (input) {
        input.required = collects;
        if (!collects) input.value = '';
      }
      if (note) {
        note.textContent = status ? status.getAttribute('data-number-note') || '' : '';
        note.hidden = collects || !note.textContent;
      }
    });
  }

  function updateSizeHint(select: HTMLSelectElement) {
    const line = select.closest('[data-product]');
    const hintEl = line ? (line.querySelector('[data-size-hint]') as HTMLElement | null) : null;
    if (!line || !hintEl) return;
    const productId = line.getAttribute('data-product') || '';
    const hint = (sizeHints[productId] || {})[select.value];
    hintEl.textContent = hint ? select.value + ' — ' + hint : '';
    hintEl.hidden = !hint;
  }

  function updateTotals() {
    let cents = 0;
    playersList.querySelectorAll('[data-player-block]').forEach((block) => {
      block.querySelectorAll('[data-product]').forEach((line) => {
        const price = parseInt(line.getAttribute('data-price-cents') || '0', 10);
        const required = line.getAttribute('data-required') === '1';
        const include = line.querySelector('[data-include]') as HTMLInputElement | null;
        if (required || (include && include.checked)) {
          const qtyEl = line.querySelector('[data-field="quantity"]') as HTMLInputElement | null;
          const qty = qtyEl ? Math.max(1, parseInt(qtyEl.value || '1', 10) || 1) : 1;
          cents += price * qty;
        }
      });
    });
    if (subtotalDisplay) subtotalDisplay.textContent = '$' + (cents / 100).toFixed(2);
  }

  function relabelPlayers() {
    const blocks = playersList.querySelectorAll('[data-player-block]');
    blocks.forEach((b, i) => {
      const label = b.querySelector('[data-player-label]') as HTMLElement | null;
      const remove = b.querySelector('[data-player-remove]') as HTMLButtonElement | null;
      const nameEl = b.querySelector('[data-field="player_name"]') as HTMLInputElement | null;
      const pname = nameEl ? nameEl.value.trim() : '';
      if (label) label.textContent = 'Player ' + (i + 1) + (pname ? ' · ' + pname : '');
      if (remove) remove.hidden = blocks.length <= 1;
      // Radio groups must be unique per player block.
      b.querySelectorAll('[data-field="player_status"]').forEach((r) => {
        (r as HTMLInputElement).name = 'player_status_' + (i + 1);
      });
    });
    updateTotals();
  }

  addBtn.addEventListener('click', () => {
    const first = playersList.querySelector('[data-player-block]') as HTMLElement | null;
    if (!first) return;
    const clone = first.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('input, select').forEach((el) => {
      const input = el as HTMLInputElement;
      if (input.type === 'checkbox' || input.type === 'radio') input.checked = false;
      else if (input.getAttribute('data-field') === 'quantity') input.value = '1';
      else input.value = '';
    });
    clone.querySelectorAll('[data-addon-fields]').forEach((f) => { (f as HTMLElement).hidden = true; });
    clone.querySelectorAll('[data-size-hint]').forEach((h) => { (h as HTMLElement).hidden = true; (h as HTMLElement).textContent = ''; });
    playersList.appendChild(clone);
    applyStatus(clone);
    relabelPlayers();
    const focusTarget = (clone.querySelector('[data-field="player_status"]') || clone.querySelector('[data-field="player_name"]')) as HTMLElement | null;
    focusTarget?.focus();
  });

  playersList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('[data-player-remove]')) {
      const block = target.closest('[data-player-block]');
      if (block && playersList.querySelectorAll('[data-player-block]').length > 1) {
        block.remove();
        relabelPlayers();
      }
    }
  });

  playersList.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('[data-include]')) {
      const line = target.closest('[data-product]');
      const fields = line ? (line.querySelector('[data-addon-fields]') as HTMLElement | null) : null;
      if (fields) fields.hidden = !(target as HTMLInputElement).checked;
    }
    if (target.matches('[data-field="player_status"]')) {
      const block = target.closest('[data-player-block]');
      if (block) applyStatus(block);
    }
    if (target.matches('select[data-field="size"]')) updateSizeHint(target as HTMLSelectElement);
    updateTotals();
  });
  playersList.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('[data-field="quantity"]')) updateTotals();
    if (target.matches('[data-field="player_name"]')) relabelPlayers();
  });

  playersList.querySelectorAll('[data-player-block]').forEach(applyStatus);
  relabelPlayers();

  // Size chart dialog
  function showChartGroup(groupId: string) {
    if (!sizeDialog) return;
    const tabs = Array.from(sizeDialog.querySelectorAll('[data-chart-tab]')) as HTMLElement[];
    const panels = Array.from(sizeDialog.querySelectorAll('[data-chart-panel]')) as HTMLElement[];
    const known = tabs.some((t) => t.getAttribute('data-chart-tab') === groupId);
    const active = known ? groupId : (tabs[0]?.getAttribute('data-chart-tab') || '');
    tabs.forEach((t) => t.setAttribute('aria-selected', t.getAttribute('data-chart-tab') === active ? 'true' : 'false'));
    panels.forEach((p) => { p.hidden = p.getAttribute('data-chart-panel') !== active; });
  }

  if (sizeDialog) {
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-open-chart]') as HTMLElement | null;
      if (!btn) return;
      let group = btn.getAttribute('data-group') || '';
      if (!group) {
        const line = btn.closest('[data-product]');
        const select = line ? (line.querySelector('select[data-field="size"]') as HTMLSelectElement | null) : null;
        const opt = select && select.selectedOptions ? select.selectedOptions[0] : null;
        group = (opt && opt.getAttribute('data-group')) || '';
      }
      showChartGroup(group);
      sizeDialog.showModal();
    });
    sizeDialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const tab = target.closest('[data-chart-tab]') as HTMLElement | null;
      if (tab) { showChartGroup(tab.getAttribute('data-chart-tab') || ''); return; }
      if (target.closest('[data-chart-close]') || target === sizeDialog) sizeDialog.close();
    });
  }

  function collectPlayers() {
    const blocks = playersList.querySelectorAll('[data-player-block]');
    return Array.from(blocks).map((b) => {
      const items: any[] = [];
      b.querySelectorAll('[data-product]').forEach((line) => {
        const productId = line.getAttribute('data-product');
        const required = line.getAttribute('data-required') === '1';
        const include = line.querySelector('[data-include]') as HTMLInputElement | null;
        if (!required && !(include && include.checked)) return;
        const item: any = { productId };
        const size = fieldVal(line, 'size');
        const number = fieldVal(line, 'number');
        const option = fieldVal(line, 'option');
        const qtyEl = line.querySelector('[data-field="quantity"]') as HTMLInputElement | null;
        if (size) item.size = size;
        if (number) item.number = number;
        if (option) item.option = option;
        item.quantity = qtyEl ? Math.max(1, parseInt(qtyEl.value || '1', 10) || 1) : 1;
        items.push(item);
      });
      const status = checkedStatus(b);
      return {
        name: fieldVal(b, 'player_name'),
        playerStatus: status ? status.value : '',
        gender: fieldVal(b, 'gender'),
        grade: fieldVal(b, 'grade'),
        items,
      };
    });
  }

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorDiv.hidden = false;
    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // --- Inline validation: errors stay next to the field until fixed ---
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  const summary = document.getElementById('form-validation-summary') as HTMLElement;

  function errorHost(c: Element): HTMLElement {
    return (c.closest('[data-status-group], .acknowledge, .form-field') as HTMLElement | null) || (c.parentElement as HTMLElement);
  }

  function messageFor(c: Control): string {
    const type = (c as HTMLInputElement).type;
    if (type === 'radio') return 'Pick one to continue.';
    if (type === 'checkbox') return 'Please check the box to continue.';
    const v = c.validity;
    if (v.valueMissing) return c.tagName === 'SELECT' ? 'Please choose one.' : 'This field is required.';
    if (v.typeMismatch && type === 'email') return 'Enter a valid email, like name@example.com.';
    if (v.patternMismatch) return 'Numbers only, 1–3 digits.';
    return c.validationMessage || 'Please check this field.';
  }

  function setFieldError(c: Control, message: string) {
    const host = errorHost(c);
    c.classList.add('error');
    c.setAttribute('aria-invalid', 'true');
    host.classList.add('has-error');
    let msg = host.querySelector(':scope > .field-error') as HTMLElement | null;
    if (!msg) {
      msg = document.createElement('span');
      msg.className = 'field-error';
      host.appendChild(msg);
    }
    msg.textContent = message;
  }

  function clearFieldError(target: Element) {
    if (!target.matches('input, select, textarea')) return;
    const host = errorHost(target);
    const group = (target as HTMLInputElement).type === 'radio' ? Array.from(host.querySelectorAll('input[type="radio"]')) : [target];
    group.forEach((el) => { el.classList.remove('error'); el.removeAttribute('aria-invalid'); });
    if (host.querySelector('.error')) return;
    host.classList.remove('has-error');
    host.querySelectorAll(':scope > .field-error').forEach((m) => m.remove());
    if (summary && !form.querySelector('.has-error')) summary.hidden = true;
  }

  function validateForm(): boolean {
    const controls = Array.from(form.querySelectorAll('input, select, textarea')) as Control[];
    controls.forEach(clearFieldError);
    let first: HTMLElement | null = null;
    let count = 0;
    controls.forEach((c) => {
      const type = (c as HTMLInputElement).type;
      if (c.disabled || type === 'hidden' || c.name === 'bot-field') return;
      if (c.checkValidity()) return;
      const host = errorHost(c);
      if (type === 'radio' && host.classList.contains('has-error')) return;
      setFieldError(c, messageFor(c));
      count++;
      if (!first) first = type === 'radio' ? host : c;
    });
    if (!first) {
      if (summary) summary.hidden = true;
      return true;
    }
    if (summary) {
      summary.textContent = count === 1
        ? 'One field needs attention — it\'s highlighted above.'
        : count + ' fields need attention — they\'re highlighted above.';
      summary.hidden = false;
    }
    const target = first as HTMLElement;
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const focusable = target.matches('input, select, textarea') ? target : (target.querySelector('input, select, textarea') as HTMLElement | null);
    focusable?.focus({ preventScroll: true });
    return false;
  }

  form.addEventListener('input', (e) => clearFieldError(e.target as Element));
  form.addEventListener('change', (e) => clearFieldError(e.target as Element));

  const submitLabel = submitBtn.textContent || '';
  function setBusy(busy: boolean) {
    submitBtn.disabled = busy;
    submitBtn.setAttribute('aria-busy', busy ? 'true' : 'false');
    submitBtn.textContent = busy ? (paymentEnabled ? 'Opening secure checkout…' : 'Sending your order…') : submitLabel;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.hidden = true;
    if (!validateForm()) return;
    setBusy(true);

    const players = collectPlayers();
    const base = {
      town_slug: townSlug,
      name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim(),
      notes: (form.elements.namedItem('notes') as HTMLTextAreaElement).value.trim(),
      acknowledge_final_sale: (form.elements.namedItem('acknowledge_final_sale') as HTMLInputElement).checked,
      players,
    };

    try {
      if (paymentEnabled) {
        const response = await fetch('/api/checkout/create-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(base),
        });
        const body = await response.json().catch(() => ({}));
        if (response.ok && body.url) {
          window.location.href = body.url;
          return;
        }
        showError(body.error || 'Could not start checkout. Please try again.');
        setBusy(false);
      } else {
        // Degraded fallback (Stripe not configured): post a readable summary.
        const summary = players.map((p, i) => {
          const lines = p.items.map((it) => '  - ' + it.productId + (it.size ? ' ' + it.size : '') + (it.number ? ' #' + it.number : '') + (it.option ? ' [' + it.option + ']' : '') + (it.quantity > 1 ? ' x' + it.quantity : '')).join('\n');
          const meta = [p.playerStatus ? p.playerStatus + ' player' : '', p.gender].filter(Boolean).join(', ');
          return 'Player ' + (i + 1) + ': ' + p.name + (meta ? ' (' + meta + ')' : '') + (p.grade ? ', grade ' + p.grade : '') + '\n' + lines;
        }).join('\n\n');
        const fd = new URLSearchParams();
        fd.set('form-name', 'parent-order');
        fd.set('town', townName);
        fd.set('town_slug', townSlug);
        fd.set('name', base.name);
        fd.set('email', base.email);
        fd.set('phone', base.phone);
        fd.set('notes', base.notes);
        fd.set('order_summary', summary);
        const response = await fetch('/api/inbox/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: fd.toString(),
        });
        if (response.ok) {
          form.hidden = true;
          successDiv.hidden = false;
          successDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('Server error');
        }
      }
    } catch {
      showError('Something went wrong. Please call (978) 352-8240 and we\'ll help you out.');
      setBusy(false);
    }
  });
</script>
