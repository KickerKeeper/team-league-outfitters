---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/business';
import { ORDER_TIMING_NOTE } from '../lib/delivery';
---

<Base
  title="Contact Us — Georgetown Jerseys"
  description="Georgetown Jerseys is now fully remote. Email Jamie at jamienadeau@georgetownjerseys.com with any questions about team uniforms and orders."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Contact Us</h1>
      <p>We've gone fully remote. Email is the fastest way to reach us.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-info">
        <div class="moved-notice" role="note">
          <strong>We've moved out of our brick-and-mortar store in Georgetown</strong> and now run a fully remote operation. Orders are placed online and shipped to you or left for porch pickup in Georgetown.
        </div>

        <div class="info-block">
          <h2>Email Jamie</h2>
          <p class="email-link"><a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a></p>
          <p class="info-note">Questions about sizing, numbers, pickup, or a team order &mdash; send them over and we'll get right back to you.</p>
        </div>

        <div class="info-block">
          <h2>Getting Your Order</h2>
          <ul class="delivery-list">
            <li><strong>Porch pickup in Georgetown</strong> &mdash; free. We'll email you pickup details once your order is ready.</li>
            <li><strong>Ship to home</strong> &mdash; flat $10, added at checkout.</li>
          </ul>
          <p class="info-note">{ORDER_TIMING_NOTE}</p>
        </div>

        <div class="info-block">
          <a href="/order" class="btn btn-primary">Place an Order</a>
        </div>
      </div>

      <aside class="contact-aside card">
        <h3>Still based in Georgetown</h3>
        <p>Same owners, same custom work, same local teams. We just don't have a storefront anymore, so there are no walk-in hours and no shop phone.</p>
        <p>Everything runs through the online order form and <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .page-header {
    background: var(--color-primary);
    color: #fff;
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }

  .page-header h1 { color: #fff; margin-bottom: var(--space-3); }
  .page-header p { opacity: 0.9; max-width: 520px; margin: 0 auto; }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-12);
    }
  }

  .moved-notice {
    background: var(--color-accent-light);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-neutral-900);
  }

  .info-block { margin-bottom: var(--space-8); }
  .info-block:last-child { margin-bottom: 0; }
  .info-block h2 { font-size: var(--text-xl); margin-bottom: var(--space-2); }

  .email-link a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--color-primary);
    word-break: break-all;
  }

  .info-note {
    font-size: var(--text-sm);
    color: var(--color-neutral-600);
    margin-top: var(--space-2);
  }

  .delivery-list { list-style: none; padding: 0; margin: 0; }
  .delivery-list li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-neutral-200); }
  .delivery-list li:last-child { border-bottom: none; }

  .contact-aside { padding: var(--space-6); }
  .contact-aside h3 { margin-bottom: var(--space-3); }
  .contact-aside p { font-size: var(--text-sm); color: var(--color-neutral-600); margin-bottom: var(--space-3); }
  .contact-aside p:last-child { margin-bottom: 0; }
  .contact-aside a { color: var(--color-primary); font-weight: 600; word-break: break-all; }
</style>
